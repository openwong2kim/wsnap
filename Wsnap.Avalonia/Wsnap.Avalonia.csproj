<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- New sibling project for the Avalonia UI migration (docs: plans/humming-meandering-aurora.md,
         also mirrored at C:\Users\rizz\.claude\plans\humming-meandering-aurora.md). WPF's Wsnap.csproj
         keeps shipping ordinary bugfix releases throughout — UseWPF/UseWindowsForms are SDK-level
         flags that can't coexist with Avalonia in one project, so this is deliberately separate,
         not an in-place conversion. Only the SHIP step (release pipeline pointing at this exe
         instead of Wsnap.csproj's) is meant to be atomic; this project merges into main
         incrementally throughout the migration. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WinForms is a DELIBERATE retained island — NotifyIcon + ContextMenuStrip + the v1.8
         TrayMenuTheme.cs dark-theme owner-draw renderer have no Avalonia NativeMenu equivalent
         (NativeMenu is OS-native chrome, no owner-draw hook). Do not "purity" this away later. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Distinct from Wsnap.csproj's "wsnap" AssemblyName during parallel development, on
         purpose: two sibling SDK projects sharing one assembly name in the same tree caused
         MSBuild/obj-cache confusion for OTHER projects in this repo (.smoke's duplicate-
         AssemblyInfo build errors). Rename to "wsnap" only at the actual Phase 6 cutover. -->
    <AssemblyName>wsnap-avalonia</AssemblyName>
    <RootNamespace>Wsnap</RootNamespace>
    <Version>2.0.0</Version>
    <!-- Phase 6 (resident app): same PerMonitorV2 manifest + app icon as the WPF exe. Avalonia
         would set PerMonitorV2 itself at runtime; declaring it in the manifest makes it active
         from the first instruction (DXGI grab, WinForms Screen metrics) and matches WPF exactly. -->
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\wsnap.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WFAC010</NoWarn> <!-- DPI comes from the manifest; the WinForms hint is moot. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.*" />
    <!-- Phase 1: FluentTheme (dark variant) supplies complete control templates; Theme.axaml
         overrides its tokens with wsnap's palette and adds class-selector styles on top. -->
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.*" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.*" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <!-- The 24 UI-framework-agnostic files from Wsnap.csproj, LINKED (not copied) so there is
       exactly one copy on disk shared by both projects — no drift possible. Listed explicitly
       (no glob) so a new WPF-only file never accidentally gets pulled into this build. -->
  <ItemGroup>
    <Compile Include="..\AudioDevices.cs" Link="AudioDevices.cs" />
    <Compile Include="..\AutoStart.cs" Link="AutoStart.cs" />
    <Compile Include="..\CaptureStore.cs" Link="CaptureStore.cs" />
    <Compile Include="..\ClipboardCore.cs" Link="ClipboardCore.cs" />
    <Compile Include="..\ClipboardWatcher.cs" Link="ClipboardWatcher.cs" />
    <Compile Include="..\CrashLog.cs" Link="CrashLog.cs" />
    <Compile Include="..\DxgiGrab.cs" Link="DxgiGrab.cs" />
    <Compile Include="..\FFmpegProvider.cs" Link="FFmpegProvider.cs" />
    <Compile Include="..\GifRecorder.cs" Link="GifRecorder.cs" />
    <Compile Include="..\GifWriter.cs" Link="GifWriter.cs" />
    <Compile Include="..\HotkeyHook.cs" Link="HotkeyHook.cs" />
    <Compile Include="..\MemoryTrim.cs" Link="MemoryTrim.cs" />
    <Compile Include="..\MonitorPlacement.cs" Link="MonitorPlacement.cs" />
    <Compile Include="..\Ocr.cs" Link="Ocr.cs" />
    <Compile Include="..\RecorderUi.cs" Link="RecorderUi.cs" />
    <Compile Include="..\ScreenGrab.cs" Link="ScreenGrab.cs" />
    <Compile Include="..\ScrollCapture.cs" Link="ScrollCapture.cs" />
    <Compile Include="..\Settings.cs" Link="Settings.cs" />
    <Compile Include="..\SkiaImage.cs" Link="SkiaImage.cs" />
    <Compile Include="..\SingleInstance.cs" Link="SingleInstance.cs" />
    <Compile Include="..\Strings.cs" Link="Strings.cs" />
    <Compile Include="..\UpdateChecker.cs" Link="UpdateChecker.cs" />
    <Compile Include="..\Uploader.cs" Link="Uploader.cs" />
    <Compile Include="..\VideoRecorder.cs" Link="VideoRecorder.cs" />
    <Compile Include="..\Control\AuditLog.cs" Link="Control\AuditLog.cs" />
    <Compile Include="..\Control\Command.cs" Link="Control\Command.cs" />
    <Compile Include="..\Control\CommandCatalog.cs" Link="Control\CommandCatalog.cs" />
    <Compile Include="..\Control\ConsoleBridge.cs" Link="Control\ConsoleBridge.cs" />
    <Compile Include="..\Control\JsonRpc.cs" Link="Control\JsonRpc.cs" />
    <Compile Include="..\Control\McpStdioServer.cs" Link="Control\McpStdioServer.cs" />
    <Compile Include="..\Control\PipeClientRouter.cs" Link="Control\PipeClientRouter.cs" />
    <Compile Include="..\Control\PipeProtocol.cs" Link="Control\PipeProtocol.cs" />
    <Compile Include="..\Control\PipeServer.cs" Link="Control\PipeServer.cs" />
    <!-- Phase 4: the full control layer links now that Toast (Phase 3a) and the recorders
         (this phase) exist on the Avalonia side. Program.Main routes `wsnap-avalonia <verb>`
         and `wsnap-avalonia mcp` through the same headless paths as the WPF exe. -->
    <Compile Include="..\Control\CaptureCore.cs" Link="Control\CaptureCore.cs" />
    <Compile Include="..\Control\CliRouter.cs" Link="Control\CliRouter.cs" />
    <Compile Include="..\Control\CommandRouter.cs" Link="Control\CommandRouter.cs" />
    <Compile Include="..\Control\ControlGate.cs" Link="Control\ControlGate.cs" />
    <!-- Phase 6: the resident app links the tray dark-theme renderer (pure WinForms — the
         deliberately retained island) and the folder-OCR watcher (framework-agnostic since
         Phase 6: SynchronizationContext marshalling + ClipboardCore). -->
    <Compile Include="..\TrayMenuTheme.cs" Link="TrayMenuTheme.cs" />
    <Compile Include="..\Control\FolderWatcher.cs" Link="Control\FolderWatcher.cs" />
  </ItemGroup>

  <!-- Phase 6: same embedded assets as Wsnap.csproj — tray icon, community locale packs, and
       the small language-agnostic OCR det+cls models (Ocr.cs extracts them at runtime). -->
  <ItemGroup>
    <EmbeddedResource Include="..\wsnap.ico" Link="wsnap.ico" />
    <EmbeddedResource Include="..\locales\*.json" Exclude="..\locales\en.json">
      <LogicalName>wsnap.locale.%(Filename).json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\models\v5\ch_PP-OCRv5_mobile_det.onnx">
      <LogicalName>wsnap.ocr.det.onnx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\models\v5\ch_ppocr_mobile_v2.0_cls_infer.onnx">
      <LogicalName>wsnap.ocr.cls.onnx</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- RapidOcrNet + Vortice.Direct3D11 are pulled in transitively by the linked Ocr.cs / DxgiGrab.cs
       files, same package refs as Wsnap.csproj. -->
  <ItemGroup>
    <PackageReference Include="RapidOcrNet" Version="2.0.0" ExcludeAssets="contentFiles" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <!-- Same pin as Wsnap.csproj: SkiaImage.cs/GifWriter.cs (linked above) use SkiaSharp directly. -->
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
  </ItemGroup>

  <!-- Same as Wsnap.csproj: RapidOcrNet.targets copies its model set loose into the publish dir;
       we embed our own models and extract at runtime, so drop the dead weight after its copy. -->
  <Target Name="WsnapAvDropLoosePublishModels" AfterTargets="CopyModelsPublish">
    <RemoveDir Directories="$(PublishDir)models" />
    <Delete Files="$(PublishDir)onnxruntime.lib;$(PublishDir)onnxruntime_providers_shared.lib" />
  </Target>

</Project>
