<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Plain windows TFM (no 10.0.x): OCR moved to ONNX (RapidOcrNet) in v1.3, so nothing uses
         WinRT any more — the 10.0.19041 target only served to ship a 25 MB Microsoft.Windows.SDK.NET
         projection assembly nobody called. Dropping it is the single biggest size cut in v1.8. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- Screen/pixel capture + NotifyIcon tray -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>wsnap.ico</ApplicationIcon>
    <AssemblyName>wsnap</AssemblyName>
    <Version>2.0.0</Version>
    <RootNamespace>Wsnap</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks> <!-- scroll-capture row matching uses pointers -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn> <!-- DPI is set via WPF manifest; WinForms hint is moot. -->

    <!-- Size trimming for the self-contained single-file build. A capture tool needs no ICU
         globalization data (~28 MB of icudt.dll) — all date/number formatting in the app uses
         explicit invariant format strings + CultureInfo.InvariantCulture, so this is safe.
         The runtime feature switches drop diagnostics/serialization machinery we never use. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- Drop the in-process debugger support (runtime hooks, PDB reader, dynamic debug info) —
         ~3–5 MB. Crashes still dump to wsnap.log via CrashLog and the WER telemetry; this only
         removes the live-debug plumbing nobody shipping a release uses. -->
    <DebuggerSupport>false</DebuggerSupport>
    <!-- ReadyToRun emits ahead-of-time native code alongside the IL for every assembly — the
         classic .NET 5–8 single-file size inflater. Turning it off ships pure IL and lets the
         JIT do its job on first launch. Costs a little cold-start (a capture tool that lives in
         the tray doesn't care) and reclaims ~8–15 MB from the bundle. -->
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Ship only en + ko satellite assemblies. The .NET desktop SDK pulls in ~20 language
         folders (zh-Hans, tr, de, fr, …) for WPF/WinForms — at ~1–2 MB each that's ~24 MB of
         pure fat for a single-binary capture tool whose own UI already ships en/ko built-in
         (Strings.cs) and only loads extra languages from locales\<code>.json. -->
    <SatelliteResourceLanguages>en;ko</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Wsnap.Avalonia/ is a SEPARATE sibling project (the Avalonia UI migration — see
         plans/humming-meandering-aurora.md); it links several of THIS project's .cs files back
         out via relative <Compile Include>, but its own .cs files (Program.cs, App.cs, scaffold
         stubs) must never be swept into this WPF build's default **/*.cs glob, or duplicate/
         conflicting type definitions (e.g. two different "Toast" classes) break the build. -->
    <Compile Remove="Wsnap.Avalonia\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so the tray icon resolves inside the single-file exe. -->
    <EmbeddedResource Include="wsnap.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Community UI translation packs. en/ko are built into Strings.cs; en.json is the
         contributor template (not shipped). Each locales\<code>.json embeds as
         wsnap.locale.<code>.json and auto-registers via L.LoadEmbeddedPacks(). Add a language
         by dropping in locales\<code>.json — no code or csproj change needed. -->
    <EmbeddedResource Include="locales\*.json" Exclude="locales\en.json">
      <LogicalName>wsnap.locale.%(Filename).json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- On-device OCR engine: PaddleOCR PP-OCRv5 models on ONNX Runtime (offline, free).
         Replaces the weak Windows.Media.Ocr engine. ExcludeAssets="contentFiles" stops the
         package from copying its own model set loose next to the exe — we embed our own models
         (below) and extract them at runtime, keeping distribution a true single file. -->
    <PackageReference Include="RapidOcrNet" Version="2.0.0" ExcludeAssets="contentFiles" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <!-- Phase 0 of the Avalonia migration: SkiaSharp is now the single image-encoding stack
         (SkiaImage.cs) — used directly, not just transitively via RapidOcrNet. Pinned to the
         exact version RapidOcrNet already pulls so no native binary changes. -->
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only the small language-agnostic OCR models stay embedded (det 4.8 MB + cls 0.6 MB) —
         they're shared by every language and HuggingFace hosts no mobile-sized equivalent.
         The Korean recognition pack (13.4 MB) is NOT embedded any more: since v1.8 it downloads
         on first OCR use through the exact same languages/korean path every other language
         already used (byte-identical files — tools/fetch-ocr-models.ps1 fetched from that URL).
         Ocr.cs extracts the embedded pair to %LOCALAPPDATA%\wsnap\models on first use. -->
    <EmbeddedResource Include="models\v5\ch_PP-OCRv5_mobile_det.onnx">
      <LogicalName>wsnap.ocr.det.onnx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="models\v5\ch_ppocr_mobile_v2.0_cls_infer.onnx">
      <LogicalName>wsnap.ocr.cls.onnx</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- RapidOcrNet.targets copies its model set loose into the output/publish dir (CopyModelsBuild /
       CopyModelsPublish). We embed our own models and extract at runtime, so those loose copies are
       dead weight that would clutter the otherwise single-file publish. Remove them right after the
       package's copy runs. Nothing reads these loose files — Ocr.cs uses the embedded resources. -->
  <Target Name="WsnapDropLoosePublishModels" AfterTargets="CopyModelsPublish">
    <RemoveDir Directories="$(PublishDir)models" />
    <Delete Files="$(PublishDir)onnxruntime.lib;$(PublishDir)onnxruntime_providers_shared.lib" />
  </Target>

  <!-- WinForms ships a 5.4 MB System.Windows.Forms.Design.dll as part of its framework reference.
       It's a designer-time assembly (PropertyGrid editors, control designers, serialization for the
       VS designer) that a runtime capture tool never loads. Drop it from the publish manifest BEFORE
       the single-file bundle runs so it never makes it into wsnap.exe. Safe because nothing in the
       app reflects over or late-binds designers — if a future feature needs them, revisit this. -->
  <Target Name="WsnapDropDesignAssemblies" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(Filename)%(Extension)' == 'System.Windows.Forms.Design.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(Filename)%(Extension)' == 'System.Windows.Forms.Design.Editors.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(Filename)%(Extension)' == 'System.Design.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(Filename)%(Extension)' == 'System.Drawing.Design.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(Filename)%(Extension)' == 'System.Windows.Forms.Design.Editors.resources'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(Filename)%(Extension)' == 'System.Windows.Forms.Design.resources'" />
    </ItemGroup>
  </Target>

  <!-- ONNX Runtime native (~14 MB) is fetched on first OCR from the official Microsoft.ML.OnnxRuntime
       NuGet package and loaded via SetDllDirectory (see Ocr.cs EnsureOnnxRuntime). Keeping it out of
       the bundle is the single biggest size cut for the majority of users who never OCR. The managed
       RapidOcrNet.dll stays (small) — only the native inference runtime is lazy. -->
  <Target Name="WsnapDropOnnxNative" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(Filename)%(Extension)' == 'onnxruntime.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(Filename)%(Extension)' == 'onnxruntime_providers_shared.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(Filename)%(Extension)' == 'onnxruntime_providers_cuda.dll'" />
    </ItemGroup>
  </Target>

</Project>
